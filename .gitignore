.superpowers

# Python virtualenv — matches at any depth (root and backend/).
.venv/

# setuptools build metadata, regenerated by every `pip install -e`.
# Never hand-maintained; see backend/.gitignore for the rest of the
# Python artefacts.
*.egg-info/

# Deploy-time secrets and build output — never committed.
backend/.env
deploy/frontend_dist/

# Local amoCRM probe for ADR-0051: script, its token file, raw API responses.
scripts/amo_adr_probe.py
scripts/amo_adr_probe2.py
scripts/amo_adr_probe3.py
scripts/amo_adr_probe4.py
scripts/.env.amo
scripts/probe_out/
